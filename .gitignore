# =============================================================================
# VGS Monorepo — .gitignore global
# =============================================================================

# --- Terraform ---
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
terraform/crash.log
terraform/override.tf
terraform/override.tf.json
terraform/*_override.tf
terraform/*_override.tf.json

# --- Worker / Node.js ---
worker/node_modules/
worker/.dev.vars
worker/.wrangler/
worker/*.log

# --- OS / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# --- Logs ---
*.log
npm-debug.log*

# --- Env ---
.env
.env.*
!.env.example
